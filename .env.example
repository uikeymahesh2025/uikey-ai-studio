# ==========================================
# UIKEY AI Studio - Environment Variables
# ==========================================

# Supabase Configuration (Optional in Demo Mode)
# Leave empty or keep DEMO_MODE=true to use interactive mock data & local storage
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public App Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Mode Flags (Free-First Architecture)
DEMO_MODE=true
PAYMENT_MODE=manual_upi
WHATSAPP_MODE=manual
AI_MODE=disabled
STORAGE_PROVIDER=supabase

# Studio Defaults
NEXT_PUBLIC_STUDIO_NAME="UIKEY AI Studio"
NEXT_PUBLIC_STUDIO_UPI="uikeystudio@upi"
NEXT_PUBLIC_STUDIO_WATERMARK="PROOF ONLY · UIKEY AI STUDIO"
